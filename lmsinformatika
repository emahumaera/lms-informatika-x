        function simpanNilai(studentName, pertemuanId) {
            const nAwal = document.getElementById(`nAwal_${studentName}_${pertemuanId}`).value;
            const nPros = document.getElementById(`nPros_${studentName}_${pertemuanId}`).value;
            const nAkh = document.getElementById(`nAkh_${studentName}_${pertemuanId}`).value;
            const nKet = document.getElementById(`nKet_${studentName}_${pertemuanId}`).value;

            let existing = APP_DATA.grades.find(g => g.studentName === studentName && g.pertemuanId === pertemuanId);
            if(existing) {
                existing.nilaiAwal = nAwal;
                existing.nilaiProses = nPros;
                existing.nilaiAkhir = nAkh;
                existing.keterangan = nKet;
            } else {
                APP_DATA.grades.push({
                    studentName: studentName,
                    pertemuanId: pertemuanId,
                    nilaiAwal: nAwal,
                    nilaiProses: nPros,
                    nilaiAkhir: nAkh,
                    keterangan: nKet
                });
            }
            saveDB();
            alert(`Nilai untuk ${studentName} berhasil disimpan!`);
        }

