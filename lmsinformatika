        function renderAbsensiMatrix() {
            const select = document.getElementById('absensiKolomPilih');
            if(select && select.options.length === 0) {
                select.innerHTML = "";
                for(let i=1; i<=30; i++) {
                    select.innerHTML += `<option value="${i}">Pertemuan ke-${i}</option>`;
                }
            }

            const currentMeetingNo = select ? parseInt(select.value) || 1 : 1;
            
            const meetingAbsData = APP_DATA.absensi.find(a => a.meetingNo === currentMeetingNo);
            const tglInput = document.getElementById('absensiTanggalInput');
            if(tglInput) {
                tglInput.value = meetingAbsData && meetingAbsData.tanggal ? meetingAbsData.tanggal : '';
            }

            for(let i=1; i<=30; i++) {
                const thEl = document.getElementById(`tgl_th_${i}`);
                if(thEl) {
                    const match = APP_DATA.absensi.find(a => a.meetingNo === i);
                    if(match && match.tanggal) {
                        const dParts = match.tanggal.split('-');
                        if(dParts.length === 3) {
                            const months = ['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agu','Sep','Okt','Nov','Des'];
                            const mStr = months[parseInt(dParts[1])-1] || '';
                            thEl.innerText = `${dParts[2]}-${mStr}`;
                        } else {
                            thEl.innerText = match.tanggal;
                        }
                    } else {
                        thEl.innerText = '-';
                    }
                }
            }

            const tbody = document.getElementById('tabelMatriksAbsensiBody');
            if(!tbody) return;
            tbody.innerHTML = "";

            if(APP_DATA.students.length === 0) {
                tbody.innerHTML = `<tr><td colspan="35" style="padding:20px; color:#64748B;">Belum ada data murid terdaftar. Tambahkan murid di menu Data Murid.</td></tr>`;
                return;
            }

            APP_DATA.students.forEach((student, sIdx) => {
                let rowHtml = `<tr>`;
                rowHtml += `<td style="border: 1px solid rgba(168,85,247,0.15); padding: 10px; font-weight: 600; text-align: left; background:#F8FAFC;">${sIdx+1}. ${student}</td>`;

                let totalHdr = 0;
                let totalS = 0;
                let totalI = 0;
                let totalA = 0;
                let recordedMeetingsCount = 0;

                for(let m=1; m<=30; m++) {
                    const absRecord = APP_DATA.absensi.find(a => a.meetingNo === m);
                    const status = absRecord && absRecord.records && absRecord.records[student] ? absRecord.records[student] : '-';

                    if(status !== '-') recordedMeetingsCount++;
                    if(status === 'H') totalHdr++;
                    if(status === 'S') totalS++;
                    if(status === 'I') totalI++;
                    if(status === 'A') totalA++;

                    let badgeColorBg = "#F8FAFC";
                    let badgeColorText = "#64748B";
                    if(status === 'H') { badgeColorBg = "rgba(16,185,129,0.15)"; badgeColorText = "#059669"; }
                    else if(status === 'S') { badgeColorBg = "rgba(239,68,68,0.15)"; badgeColorText = "#DC2626"; }
                    else if(status === 'I') { badgeColorBg = "rgba(245,158,11,0.15)"; badgeColorText = "#D97706"; }
                    else if(status === 'A') { badgeColorBg = "rgba(249,115,22,0.15)"; badgeColorText = "#EA580C"; }

                    const safeStudent = student.replace(/'/g, "\\'");
                    rowHtml += `<td style="border: 1px solid rgba(168,85,247,0.15); padding: 4px; cursor:pointer;" onclick="cycleAbsensiStatus('${safeStudent}', ${m})" title="Klik ubah status ${student} pertemuan ${m}">
                        <div style="background:${badgeColorBg}; color:${badgeColorText}; font-weight:700; border-radius:6px; padding:6px 2px; font-size:11px; border:1px solid rgba(168,85,247,0.1);">${status}</div>
                    </td>`;
                }

                let pct = recordedMeetingsCount > 0 ? Math.round((totalHdr / recordedMeetingsCount) * 100) : 0;
                rowHtml += `<td style="border: 1px solid rgba(168,85,247,0.15); font-weight:700; color:var(--primary-purple); background:rgba(124,58,237,0.08);">${pct}%</td>`;
                rowHtml += `<td style="border: 1px solid rgba(168,85,247,0.15); font-weight:600; color:#DC2626; background:rgba(239,68,68,0.05);">${totalS}</td>`;
                rowHtml += `<td style="border: 1px solid rgba(168,85,247,0.15); font-weight:600; color:#D97706; background:rgba(245,158,11,0.05);">${totalI}</td>`;
                rowHtml += `<td style="border: 1px solid rgba(168,85,247,0.15); font-weight:600; color:#EA580C; background:rgba(249,115,22,0.05);">${totalA}</td>`;

                rowHtml += `</tr>`;
                tbody.innerHTML += rowHtml;
            });
        }

        function pilihPertemuanAbsensiGrid(meetingNo) {
            const select = document.getElementById('absensiKolomPilih');
            if(select) {
                select.value = meetingNo;
                renderAbsensiMatrix();
            }
        }

        function cycleAbsensiStatus(studentName, meetingNo) {
            let absRecord = APP_DATA.absensi.find(a => a.meetingNo === meetingNo);
            if(!absRecord) {
                absRecord = { meetingNo: meetingNo, tanggal: new Date().toISOString().split('T')[0], records: {} };
                APP_DATA.absensi.push(absRecord);
            }
            if(!absRecord.records) absRecord.records = {};

            const current = absRecord.records[studentName] || '-';
            let next = '-';
            if(current === '-') next = 'H';
            else if(current === 'H') next = 'S';
            else if(current === 'S') next = 'I';
            else if(current === 'I') next = 'A';
            else if(current === 'A') next = '-';

            absRecord.records[studentName] = next;
            saveDB();
            renderAbsensiMatrix();
        }

        function simpanTanggalAbsensi() {
            const select = document.getElementById('absensiKolomPilih');
            const tglInput = document.getElementById('absensiTanggalInput');
            if(!select || !tglInput) return;

            const meetingNo = parseInt(select.value);
            const tglVal = tglInput.value;

            let absRecord = APP_DATA.absensi.find(a => a.meetingNo === meetingNo);
            if(!absRecord) {
                absRecord = { meetingNo: meetingNo, tanggal: tglVal, records: {} };
                APP_DATA.absensi.push(absRecord);
            } else {
                absRecord.tanggal = tglVal;
            }
            saveDB();
            renderAbsensiMatrix();
        }

        function simpanUrlClassroom() {
            APP_DATA.classroomUrl = document.getElementById('g_classroomUrl').value;
            saveDB();
            document.getElementById('btnBukaClassroom').href = APP_DATA.classroomUrl;
            alert('URL Google Classroom diperbarui!');
        }

        function populatePertemuanSiswaSelects() {
            const selectMat = document.getElementById('selectPertemuanMateri');
            const selectTug = document.getElementById('selectPertemuanTugas');
            if(!selectMat || !selectTug) return;
            selectMat.innerHTML = ""; selectTug.innerHTML = "";
            
            APP_DATA.pertemuan.forEach(p => {
                selectMat.innerHTML += `<option value="${p.id}">${p.judul}</option>`;
                selectTug.innerHTML += `<option value="${p.id}">${p.judul}</option>`;
            });
            loadMateriSiswa();
            loadTugasSiswa();
        }

        function loadMateriSiswa() {
            const selectMat = document.getElementById('selectPertemuanMateri');
            const container = document.getElementById('contentMateriSiswa');
            if(!selectMat || !container) return;

            const pId = parseInt(selectMat.value);
            const p = APP_DATA.pertemuan.find(x => x.id === pId);

            if (!p) { container.innerHTML = "<p>Materi belum tersedia.</p>"; return; }

            let fileViewer = renderFileInline(p.materiFile);

            container.innerHTML = `
                <div class="card">
                    <h3 style="color:var(--accent-yellow); margin-top:0;">📘 Materi Ajar & Referensi</h3>
                    <p style="white-space: pre-line; line-height: 1.6; color:#E2E8F0;">${p.materiText || 'Tidak ada teks materi pengantar.'}</p>
                    ${fileViewer}
                </div>
            `;
        }

        function loadTugasSiswa() {
            const selectTug = document.getElementById('selectPertemuanTugas');
            const container = document.getElementById('contentTugasSiswa');
            if(!selectTug || !container) return;

            const pId = parseInt(selectTug.value);
            const p = APP_DATA.pertemuan.find(x => x.id === pId);

            if (!p) { container.innerHTML = "<p>Tugas belum tersedia.</p>"; return; }

            let lkpdInline = renderFileInline(p.lkpdFile);
            let linkHtml = p.lkpdLink ? `<div style="margin-top:15px; padding:15px; background:rgba(243,232,255,0.5); border-radius:12px; border:1px solid rgba(168,85,247,0.3);">
                <strong>🔗 Tautan/Link Disematkan Guru:</strong><br>
                <a href="${p.lkpdLink}" target="_blank" class="file-link" style="display:inline-block; margin-top:8px; text-decoration:none;">Buka Link Referensi LKPD</a>
            </div>` : '';

            container.innerHTML = `
                <div class="card">
                    <h3 style="color:var(--primary-purple); margin-top:0;">📋 Lembar Kerja Peserta Didik (E-LKPD)</h3>
                    <p style="color:var(--text-dark);"><strong>Instruksi Guru:</strong> ${p.lkpdText || '-'}</p>
                    ${linkHtml}
                    ${lkpdInline}

                    <hr style="margin:25px 0; border:0; border-top:1px solid rgba(168,85,247,0.2);">

                    <h4 style="color:var(--primary-purple);">📤 Form Pengiriman Tugas Murid</h4>
                    <form onsubmit="kirimTugasSiswa(event, ${p.id}, 'E-LKPD')">
                        <div class="form-group">
                            <label>Ketik Jawaban / Catatan Tugas:</label>
                            <textarea id="s_answer_text_${p.id}" rows="4" placeholder="Ketik penjelasan atau jawaban tugas Anda di sini..."></textarea>
                        </div>
                        <div class="form-group">
                            <label>Sematkan Tautan / Link Tugas (Opsional):</label>
                            <input type="url" id="s_answer_link_${p.id}" placeholder="https://... (Drive, YouTube, Canva, dll)">
                        </div>
                        <div class="form-group">
                            <label>Unggah File Tugas (PDF, Word, PPT, JPG, PNG, Video):</label>
                            <input type="file" id="s_answer_file_${p.id}" accept=".pdf,.doc,.docx,.ppt,.pptx,image/*,video/*">
                            <small style="color:var(--text-light); font-size:11px;">*Mendukung dokumen, gambar, hingga video.</small>
                        </div>
                        <button type="submit" class="btn-submit">Kirim Tugas ke Bu Ema</button>
                    </form>
                </div>
            `;
        }

        async function kirimTugasSiswa(e, pertemuanId, tipe) {
            e.preventDefault();
            if(!currentUser || currentUser.role !== 'siswa') return;

            const textVal = document.getElementById(`s_answer_text_${pertemuanId}`).value;
            const linkVal = document.getElementById(`s_answer_link_${pertemuanId}`).value;
            const fileInput = document.getElementById(`s_answer_file_${pertemuanId}`);
            let fileObj = null;
            if(fileInput && fileInput.files[0]) {
                fileObj = await readFileAsBase64(fileInput.files[0]);
            }

            // Remove previous submission for this meeting by this student if any, or push new
            APP_DATA.submissions = APP_DATA.submissions.filter(s => !(s.studentName === currentUser.name && s.pertemuanId === pertemuanId && s.type === tipe));

            APP_DATA.submissions.push({
                studentName: currentUser.name,
                pertemuanId: pertemuanId,
                type: tipe,
                text: textVal,
                linkInput: linkVal,
                fileName: fileObj ? fileObj.name : null,
                fileData: fileObj ? fileObj.data : null,
                timestamp: new Date().toLocaleString()
            });

            saveDB();
            alert('Tugas Anda berhasil dikirim ke guru!');
            renderPortofolioSaya();
        }

        function renderPortofolioSaya() {
            const container = document.getElementById('rekapPortofolioSiswa');
            if(!container || !currentUser || currentUser.role !== 'siswa') return;

            const studentName = currentUser.name;
            let html = `
                <div class="card">
                    <h3 style="color:var(--primary-purple); margin-top:0;">Halo, ${studentName}! Berikut Rekapitulasi Nilai & Tugas Anda:</h3>
                </div>
            `;

            if(APP_DATA.pertemuan.length === 0) {
                html += `<p>Belum ada pertemuan aktif.</p>`;
                container.innerHTML = html;
                return;
            }

            html += `<table><thead><tr><th>Pertemuan</th><th>Tugas / Kiriman Anda</th><th>Nilai Awal</th><th>Nilai Proses</th><th>Nilai Akhir</th><th>Catatan Guru</th></tr></thead><tbody>`;

            APP_DATA.pertemuan.forEach(p => {
                const subs = APP_DATA.submissions.filter(s => s.studentName === studentName && s.pertemuanId === p.id);
                const grade = APP_DATA.grades.find(g => g.studentName === studentName && g.pertemuanId === p.id) || { nilaiAwal: '-', nilaiProses: '-', nilaiAkhir: '-', keterangan: '-' };

                let subInfo = "<span style='color:#94A3B8; font-style:italic;'>Belum dikirim</span>";
                if(subs.length > 0) {
                    subInfo = "";
                    subs.forEach(s => {
                        let fBadge = s.fileName ? `<br><a href="${s.fileData}" download="${s.fileName}" class="file-link" style="font-size:11px;">💾 ${s.fileName}</a>` : "";
                        let lBadge = s.linkInput ? `<br><a href="${s.linkInput}" target="_blank" style="font-size:11px; color:#60A5FA;">🔗 Link Tugas</a>` : "";
                        subInfo += `<div style="font-size:12px; margin-bottom:4px;"><strong>${s.type}:</strong> ${s.text || '-'} ${fBadge} ${lBadge}</div>`;
                    });
                }

                html += `<tr>
                    <td><strong>${p.judul}</strong></td>
                    <td>${subInfo}</td>
                    <td><span style="font-weight:600; color:var(--primary-purple);">${grade.nilaiAwal || '-'}</span></td>
                    <td><span style="font-weight:600; color:var(--primary-purple);">${grade.nilaiProses || '-'}</span></td>
                    <td><span style="font-weight:700; color:#10B981;">${grade.nilaiAkhir || '-'}</span></td>
                    <td><span style="font-style:italic; color:var(--text-light);">${grade.keterangan || '-'}</span></td>
                </tr>`;
            });

            html += `</tbody></table>`;
            container.innerHTML = html;
        }
    </script>
</body>
</html>
