        function renderPortofolioTabel() {
            const tbody = document.getElementById('tabelPortofolioGuru');
            const filterId = document.getElementById('selectFilterPertemuan').value;
            if(!tbody) return;

            let html = "";
            let filteredPertemuan = filterId === "ALL" ? APP_DATA.pertemuan : APP_DATA.pertemuan.filter(p => p.id == filterId);

            APP_DATA.students.forEach(student => {
                filteredPertemuan.forEach(p => {
                    const subs = APP_DATA.submissions.filter(s => s.studentName === student && s.pertemuanId === p.id);
                    const grade = APP_DATA.grades.find(g => g.studentName === student && g.pertemuanId === p.id) || { nilaiAwal: '', nilaiProses: '', nilaiAkhir: '', keterangan: '' };

                    let subsHtml = "";
                    if(subs.length === 0) {
                        subsHtml = '<span style="color:#94A3B8; font-style:italic; font-size:12px;">Belum ada kiriman</span>';
                    } else {
                        subs.forEach(sub => {
                            let fLink = sub.fileName ? `<br><a href="${sub.fileData}" download="${sub.fileName}" class="file-link" style="font-size:11px;">📁 ${sub.fileName}</a>` : '';
                            let lLink = sub.linkInput ? `<br><a href="${sub.linkInput}" target="_blank" style="font-size:11px; color:#60A5FA;">🔗 Link</a>` : '';
                            subsHtml += `<div style="margin-bottom:6px; font-size:12px;"><strong>${sub.type}:</strong> ${sub.text || '-'} ${fLink} ${lLink}</div>`;
                        });
                    }

                    html += `<tr>
                        <td><strong>${student}</strong></td>
                        <td>X Keramik A</td>
                        <td>${p.judul}</td>
                        <td>${subsHtml}</td>
                        <td><input type="number" style="width:70px; padding:6px; background:rgba(15,23,42,0.6); border:1px solid rgba(255,255,255,0.2); color:#fff; border-radius:6px;" id="nAwal_${student}_${p.id}" value="${grade.nilaiAwal}" placeholder="0-100"></td>
                        <td><input type="number" style="width:70px; padding:6px; background:rgba(15,23,42,0.6); border:1px solid rgba(255,255,255,0.2); color:#fff; border-radius:6px;" id="nPros_${student}_${p.id}" value="${grade.nilaiProses}" placeholder="0-100"></td>
                        <td><input type="number" style="width:70px; padding:6px; background:rgba(15,23,42,0.6); border:1px solid rgba(255,255,255,0.2); color:#fff; border-radius:6px;" id="nAkh_${student}_${p.id}" value="${grade.nilaiAkhir}" placeholder="0-100"></td>
                        <td><input type="text" style="width:120px; padding:6px; background:rgba(15,23,42,0.6); border:1px solid rgba(255,255,255,0.2); color:#fff; border-radius:6px;" id="nKet_${student}_${p.id}" value="${grade.keterangan}" placeholder="Catatan..."></td>
