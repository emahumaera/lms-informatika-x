        function readFileAsBase64(file) {
            return new Promise((resolve, reject) => {
                if (!file) resolve(null);
                const reader = new FileReader();
                reader.onload = () => resolve({ 
                    name: file.name, 
                    type: file.type, 
                    data: reader.result 
                });
                reader.onerror = error => reject(error);
                reader.readAsDataURL(file);
            });
        }

        function renderFileInline(fileObj) {
            if(!fileObj) return '';
            const mime = fileObj.type || '';
            const fileName = (fileObj.name || '').toLowerCase();
            
            if(mime.startsWith('image/')) {
                return `<div style="margin-top:10px;"><img src="${fileObj.data}" class="img-preview" alt="Preview Gambar">
                        <br><a href="${fileObj.data}" download="${fileObj.name}" class="file-link">💾 Unduh Gambar (${fileObj.name})</a></div>`;
            } 
            else if(mime === 'application/pdf') {
                return `<div style="margin-top:10px;"><iframe src="${fileObj.data}" class="file-preview"></iframe>
                        <br><a href="${fileObj.data}" download="${fileObj.name}" class="file-link">💾 Unduh PDF (${fileObj.name})</a></div>`;
            }
            else if(mime.startsWith('video/')) {
                return `<div style="margin-top:10px;"><video controls class="video-preview"><source src="${fileObj.data}" type="${mime}">Browser Anda tidak mendukung pemutar video.</video>
                        <br><a href="${fileObj.data}" download="${fileObj.name}" class="file-link">💾 Unduh Video (${fileObj.name})</a></div>`;
            }
            else if(mime.includes('presentation') || mime.includes('powerpoint') || mime.includes('officedocument') || fileName.endsWith('.ppt') || fileName.endsWith('.pptx')) {
                return `<div style="margin-top:10px; padding:15px; background:rgba(243,232,255,0.5); border-radius:12px; text-align:center; border:1px solid rgba(168,85,247,0.2);">
                            <p style="font-weight:600; color:var(--primary-purple); margin-bottom:10px;">📊 File Presentasi / Dokumen: ${fileObj.name}</p>
                            <iframe src="${fileObj.data}" class="file-preview" style="height:300px;"></iframe>
                            <br><a href="${fileObj.data}" download="${fileObj.name}" class="file-link" style="margin-top:10px; display:inline-block;">💾 Unduh File Presentasi (${fileObj.name})</a>
                        </div>`;
            }
            else {
                return `<div style="margin-top:10px;"><a href="${fileObj.data}" download="${fileObj.name}" class="file-link">📁 Unduh Lampiran: <b>${fileObj.name}</b></a></div>`;
            }
        }

        async function simpanPertemuanBaru(e) {
            e.preventDefault();
            const judul = document.getElementById('g_judulPertemuan').value;
            const materiText = document.getElementById('g_materiText').value;
            const lkpdText = document.getElementById('g_lkpdText').value;
            const lkpdLink = document.getElementById('g_lkpdLink').value;
            const rubrikText = document.getElementById('g_rubrikText').value;
            const asesmenTipe = document.getElementById('g_jenisAsesmen').value;
            const asesmenText = document.getElementById('g_asesmenText').value;

            const materiFile = await readFileAsBase64(document.getElementById('g_materiFile').files[0]);
            const lkpdFile = await readFileAsBase64(document.getElementById('g_lkpdFile').files[0]);
            const rubrikFile = await readFileAsBase64(document.getElementById('g_rubrikFile').files[0]);
            const asesmenFile = await readFileAsBase64(document.getElementById('g_asesmenFile').files[0]);

            const newP = {
                id: Date.now(),
                judul: judul,
                materiText: materiText, materiFile: materiFile,
                lkpdText: lkpdText, lkpdLink: lkpdLink, lkpdFile: lkpdFile,
                rubrikText: rubrikText, rubrikFile: rubrikFile,
                asesmenTipe: asesmenTipe, asesmenText: asesmenText, asesmenFile: asesmenFile
