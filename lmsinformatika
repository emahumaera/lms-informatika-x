                        <div style="margin-top:6px;">${renderFileInline(p.materiFile)}</div>
                    </div>`;
                }

                let lkpdInfo = p.lkpdText ? p.lkpdText.substring(0, 40) + "..." : "";
                if(p.lkpdLink) lkpdInfo += `<br><a href="${p.lkpdLink}" target="_blank" style="color:#60A5FA; font-size:12px; font-weight:600;">🔗 Link: ${p.lkpdLink}</a>`;
                if(p.lkpdFile) lkpdInfo += `<br><span style="color:var(--accent-yellow); font-size:12px; font-weight:600;">📁 ${p.lkpdFile.name}</span>`;

                html += `<tr>
                    <td><strong>${p.judul}</strong></td>
                    <td>${materiInfo}</td>
                    <td>${lkpdInfo}</td>
                    <td><button onclick="hapusPertemuan(${p.id})" class="btn-danger">Hapus</button></td>
                </tr>`;
            });
            html += `</tbody></table>`;
            container.innerHTML = html;
        }

        function hapusPertemuan(id) {
            if(confirm("Yakin ingin menghapus pertemuan ini?")) {
